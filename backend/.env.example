# SOMA backend configuration
# Copy to .env and fill in values before running.

# Listening port
PORT=8765

# Gmail IMAP — for real email trigger
# Leave blank to use the dashboard "Skip to Infected" button instead
GMAIL_USER=soma.cyberdefense.demo@gmail.com
GMAIL_APP_PASSWORD=

# Honeypot Docker image and network config
HONEYPOT_PORT=8766
HONEYPOT_HTTP_PORT=8082
HONEYPOT_IMAGE=soma_honeypot_image
HONEYPOT_IP=172.22.0.99

# Node configuration
# VICTIM_NODE is the host machine monitored via psutil
VICTIM_NODE=User0
# HOST_NODES are Docker container agents (comma-separated)
HOST_NODES=Enterprise0,Enterprise1,Op_Server0
# Network prefix for lateral movement detection
SOMA_NET_CIDR=172.22.0.

# Anomaly detection tuning
# ANOMALY_THRESHOLD: display_score that triggers INFECTED state
ANOMALY_THRESHOLD=0.40
# INFECTED_DWELL: seconds anomaly must persist before ISOLATING fires
INFECTED_DWELL=5
# WINDOW_SIZE: rolling baseline window in ticks (seconds)
WINDOW_SIZE=60
